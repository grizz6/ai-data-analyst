# Copy to backend/.env (or export these) before starting the backend.

# Largest accepted upload, in megabytes.
# ADA_MAX_UPLOAD_MB=90
# A CSV's size once decompressed (browsers gzip CSVs before upload).
# ADA_MAX_CSV_MB=200
# Excel is opened whole, so it has its own, lower limit.
# ADA_MAX_EXCEL_MB=15
# Larger files are analyzed on a random sample of this many rows.
# ADA_MAX_ANALYSIS_ROWS=100000
# Largest size an .xlsx may expand to once unzipped.
# ADA_MAX_EXCEL_UNZIPPED_MB=100

# Where stored analyses live (SQLite, created on first run).
# ADA_DATABASE_PATH=backend/data/ada.sqlite3

# How long an analysis is kept after last use, and how many are kept at once.
# ADA_SESSION_TTL_MINUTES=60
# ADA_MAX_SESSIONS=20

# Uploads and questions one visitor (IP address) may make per hour; 0 means no limit.
# ADA_UPLOADS_PER_HOUR=10
# ADA_QUESTIONS_PER_HOUR=30
# Behind a host's edge proxy: a header it overwrites with the visitor's address
# (Render: true-client-ip). Otherwise, the number of proxies appending to
# X-Forwarded-For; 0 ignores that header.
# ADA_CLIENT_IP_HEADER=
# ADA_TRUSTED_PROXY_HOPS=0

# Language model for explanations. Leave the key empty to use rule-based text.
# Any OpenAI-compatible chat completions API works; the defaults point at
# GPT-OSS 120B on Groq (free key at https://console.groq.com).
ADA_LLM_API_KEY=
# ADA_LLM_BASE_URL=https://api.groq.com/openai/v1
# ADA_LLM_MODEL=openai/gpt-oss-120b
# ADA_LLM_FALLBACK_MODELS=["openai/gpt-oss-20b"]
