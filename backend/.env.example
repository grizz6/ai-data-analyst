# Copy to backend/.env (or export these) before starting the backend.

# Largest accepted upload, in megabytes.
# ADA_MAX_UPLOAD_MB=10

# Language model for explanations. Leave the key empty to use rule-based text.
# Any OpenAI-compatible chat completions API works; the defaults point at
# Llama 3.3 70B on Groq (free key at https://console.groq.com).
ADA_LLM_API_KEY=
# ADA_LLM_BASE_URL=https://api.groq.com/openai/v1
# ADA_LLM_MODEL=llama-3.3-70b-versatile
